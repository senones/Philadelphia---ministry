{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/static",
  "functions": { "api/cms-translate.js": { "maxDuration": 60 } },
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/((?!api(?:/|$)|admin(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/admin/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'" }
    ] }
  ]
}
